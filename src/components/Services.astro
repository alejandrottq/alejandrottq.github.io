---

<section id="servicios" class="py-16 md:py-24 bg-slate-50 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
        Mis Servicios & Especialidades
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        ¿En qué te puedo ayudar para hacer crecer tu proyecto?
      </h2>
      <p class="text-slate-600 text-base sm:text-lg">
        Cada uno de mis servicios incluye atención personal, código limpio y el respaldo de mi empresa ABLY PERU.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map(service => (
        <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-8 flex flex-col justify-between hover:border-brand-500 hover:shadow-lg transition-all group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center group-hover:bg-brand-500 group-hover:text-white transition-colors shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <Fragment set:html={service.icon} />
                </svg>
              </div>
              <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md">
                {service.category}
              </span>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900 group-hover:text-brand-600 transition-colors">
              {service.title}
            </h3>

            <p class="text-slate-600 text-sm leading-relaxed">
              {service.description}
            </p>

            <ul class="space-y-2 pt-2 text-xs text-slate-700 border-t border-slate-100">
              {service.features.map(feature => (
                <li class="flex items-center gap-2">
                  <span class="text-brand-500 font-bold">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-100">
            <a 
              href={`https://wa.me/51935381848?text=Hola%20Alejandro,%20me%20gustar%C3%ADa%20consultarte%20sobre%20tu%20servicio%20de%20${encodeURIComponent(service.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-brand-600 text-white text-xs font-bold py-3 px-4 rounded-xl transition-all"
            >
              <span>Consultar conmigo</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
